{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://book-factory/schemas/task.schema.json",
  "title": "Production task",
  "description": "A single unit of work handed to an agent or a human. Self-contained: an agent should need nothing but this file and the paths it names.",
  "type": "object",
  "required": ["schema_version", "task_id", "book_id", "type", "summary", "status"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "task_id": { "type": "string" },
    "book_id": { "type": "string" },
    "type": {
      "type": "string",
      "enum": ["intake", "authoring", "illustration", "character_reference", "layout_reference",
               "page_render", "approval", "review", "qa", "assembly", "preflight", "operator_decision"]
    },
    "stage": { "type": "string" },
    "summary": { "type": "string" },
    "instructions": { "type": ["string", "null"] },
    "page_id": { "type": ["string", "null"] },
    "asset_id": { "type": ["string", "null"] },
    "scene": { "type": ["string", "null"] },
    "characters": { "type": "array", "items": { "type": "string" } },
    "references": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Book-relative paths to locked visual references this work must match."
    },
    "required_inputs": { "type": "array", "items": { "type": "string" } },
    "constraints": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "embedded_text": { "type": "boolean" },
        "maintain_character_identity": { "type": "boolean" },
        "maintain_style": { "type": "boolean" },
        "colour": { "type": "boolean" },
        "min_pixels": { "type": ["integer", "null"] }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "destination": { "type": "string", "description": "Book-relative directory drafts must be written to." },
        "submit_command": { "type": "string", "description": "The exact command that registers the work." },
        "expected_format": { "type": ["string", "null"] }
      }
    },
    "approval_required": { "type": "boolean" },
    "status": { "type": "string", "enum": ["open", "done", "cancelled"] },
    "gate": {
      "type": ["string", "null"],
      "enum": [null, "intake", "concept_lock", "voice_lock", "manuscript_lock", "visual_lock", "release_ready"],
      "description": "Which production gate this task represents, if any."
    },
    "remediation": {
      "type": "boolean",
      "description": "True when this task exists only because a prior draft failed a hard, measurable constraint."
    },
    "retry_count": {
      "type": "integer",
      "minimum": 0,
      "description": "How many prior drafts have already failed a hard constraint on this artefact."
    },
    "mode": {
      "type": ["string", "null"],
      "enum": [null, "continue_automatically", "wait_for_operator", "remediate", "blocked", "complete"],
      "description": "The production-loop continuation state - see bookfactory.core.production."
    },
    "created_at": { "type": "string" },
    "closed_at": { "type": ["string", "null"] }
  }
}
