{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://book-factory/schemas/qa-report.schema.json",
  "title": "QA report",
  "type": "object",
  "required": ["schema_version", "book_id", "run_at", "layers", "summary"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string" },
    "book_id": { "type": "string" },
    "run_at": { "type": "string" },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["layer", "status", "findings"],
        "additionalProperties": false,
        "properties": {
          "layer": { "type": "string", "enum": ["content", "visual", "technical", "assembly"] },
          "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["level", "code", "message"],
              "additionalProperties": false,
              "properties": {
                "level": { "type": "string", "enum": ["error", "warning", "info"] },
                "code": { "type": "string" },
                "message": { "type": "string" },
                "page_id": { "type": ["string", "null"] },
                "asset_id": { "type": ["string", "null"] },
                "remedy": { "type": ["string", "null"] },
                "needs_human": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["status", "errors", "warnings"],
      "additionalProperties": false,
      "properties": {
        "status": { "type": "string", "enum": ["pass", "warn", "fail"] },
        "errors": { "type": "integer" },
        "warnings": { "type": "integer" },
        "human_review_required": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
