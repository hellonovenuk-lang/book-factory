{% extends "_base.html.j2" %}
{% import "_illustration.html.j2" as art %}

{% block content %}
  <div class="stack grow chapter-sink">
    {% if copy.eyebrow %}<p class="eyebrow">{{ copy.eyebrow }}</p>{% endif %}
    {% if page.chapter is not none %}
    <div class="chapter-number">{{ '%02d' % page.chapter }}</div>
    {% endif %}
    <h1 class="chapter-title">{{ copy.heading or page.title }}</h1>
    <hr class="rule rule--short">
    {% if copy.subheading %}
    <p class="chapter-standfirst">{{ copy.subheading }}</p>
    {% endif %}

    {{ art.illustration(illustration) }}

    {% if body_paragraphs %}
    <div class="prose prose--opening" style="margin-top:1.4em">
      {% for para in body_paragraphs %}
        {% if loop.first and dropcap %}
      <p><span class="dropcap">{{ dropcap.letter }}</span>{{ dropcap.rest }}</p>
        {% else %}
      <p>{{ para }}</p>
        {% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </div>
{% endblock %}
